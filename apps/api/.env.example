PORT=3077
# systemd sets DOTENV_CONFIG_PATH=/etc/dongxin/api.env for both startup and API-key writes.
# Keep this file outside the versioned code, and use DONGXIN_DATA_DIR for runtime data.
# Same-ECS PostgreSQL: DATABASE_TLS_MODE=local and host 127.0.0.1 only.
# Remote PostgreSQL/RDS: DATABASE_TLS_MODE=verify-ca and a verified CA file.
# Keep credentials out of Git; never expose port 5432 publicly.
DATABASE_URL=
DATABASE_TLS_MODE=verify-ca
DATABASE_CA_FILE=
ARK_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
QIANFAN_API_KEY=
ZAI_API_KEY=
HUNYUAN_API_KEY=
MOONSHOT_API_KEY=
ASR_PROVIDER=
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=
TTS_PROVIDER=
TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_AUDIO_FORMAT=mp3
MQTT_ENABLED=true
MQTT_URL=mqtt://127.0.0.1:1883
# Production: mqtts://<hostname>:8883 and optional private CA bundle.
MQTT_CA_FILE=
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=dongxin-local-gateway

# Keep disabled for local development. Production deployment must use enabled
# together with a PBKDF2 password hash and a random 32+ character token secret.
OPS_AUTH_MODE=disabled
OPS_ADMIN_USERNAME=
OPS_ADMIN_DISPLAY_NAME=平台管理员
OPS_ADMIN_PASSWORD_HASH=
OPS_AUTH_TOKEN_SECRET=
OPS_CORS_ORIGINS=

# Single API process: 16 active voice tasks, 4 waiters, at most 500 ms admission.
# The 10-second voice budget includes queueing and all AI stages.
# These are admission limits, not measured bandwidth or provider capacity.
VOICE_CONCURRENCY=16
VOICE_QUEUE_LENGTH=4
VOICE_QUEUE_WAIT_MS=500
VOICE_TASK_TIMEOUT_MS=10000
ASR_CONCURRENCY=16
LLM_CONCURRENCY=16
TTS_CONCURRENCY=16
AI_STAGE_QUEUE_LENGTH=4
AI_STAGE_QUEUE_WAIT_MS=500
AI_STAGE_TIMEOUT_MS=10000
BATCH_MAX_ACTIVE_RUNS=2
MQTT_UPSTREAM_CONCURRENCY=4
MQTT_UPSTREAM_QUEUE_LENGTH=256
MQTT_UPSTREAM_QUEUE_WAIT_MS=5000

# Zero disables the daily cap. UTC day; estimates are not provider invoices.
ASR_DAILY_CALL_LIMIT=0
LLM_DAILY_CALL_LIMIT=0
TTS_DAILY_CALL_LIMIT=0
AI_DAILY_ESTIMATED_BUDGET_CNY=0
TTS_CACHE_MAX_BYTES=8388608
TTS_CACHE_TTL_MS=900000

# Text only; record count caps may remove records earlier than 90 days.
TEXT_RETENTION_DAYS=90
VOICE_HISTORY_MAX_SESSIONS=1000
VOICE_HISTORY_MAX_TURNS=200
VOICE_TEST_MAX_SESSIONS=100
VOICE_TEST_MAX_TURNS=100
DEVICE_EVENT_MAX_RECORDS=500
DEVICE_COMMAND_MAX_RECORDS=500
SYSTEM_LOG_MAX_RECORDS=1000

# Required automatically in production. Provision independent secrets over HTTPS.
DEVICE_AUTH_MODE=optional
# json is for bounded hardware pilots; postgres reads dongxin.device_credentials.
DEVICE_AUTH_BACKEND=json
DEVICE_HTTP_CREDENTIALS=

# Optional PostgreSQL text-history pilot. Requires migrations and provisioned device IDs.
# Default JSON mode remains for local development; this does not enable production.
VOICE_HISTORY_BACKEND=json

# This release is not production-capable. A small, single-instance hardware
# pilot may acknowledge JSON/in-memory limitations after arranging backups.
# Never enable for consumer production or 100k-device rollout.
DONGXIN_PILOT_JSON_MODE=
