page {
  background: #f6f8fb;
  color: #182235;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 44rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.section-card {
  background: #ffffff;
  border: 1rpx solid #e7ecf3;
  border-radius: 8rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(37, 52, 74, 0.05);
}

.section-title {
  display: block;
  color: #182235;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-subtitle {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 6rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.metric {
  min-height: 132rpx;
  border: 1rpx solid #edf1f6;
  border-radius: 8rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.metric-label {
  color: #6b7280;
  font-size: 23rpx;
}

.metric-value {
  display: block;
  color: #182235;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
  margin-top: 10rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1366d6;
  font-size: 22rpx;
  line-height: 42rpx;
  padding: 0 18rpx;
}

.tag-warn {
  background: #fff4dc;
  color: #a45d00;
}

.tag-ok {
  background: #e7f7ef;
  color: #1f7a4d;
}

.cmd-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.cmd-btn {
  min-height: 132rpx;
  background: #ffffff;
  border: 1rpx solid #e4eaf2;
  border-radius: 8rpx;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  text-align: center;
}

.cmd-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background: #eef4ff;
  color: #1366d6;
  font-size: 24rpx;
  font-weight: 700;
}

.cmd-text {
  display: block;
  color: #182235;
  font-size: 24rpx;
  line-height: 1.35;
  margin-top: 12rpx;
}

.primary-btn {
  height: 84rpx;
  border-radius: 8rpx;
  background: #1366d6;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 84rpx;
}

.ghost-btn {
  height: 76rpx;
  border-radius: 8rpx;
  background: #eef4ff;
  color: #1366d6;
  font-size: 26rpx;
  line-height: 76rpx;
}

.input {
  min-height: 84rpx;
  background: #ffffff;
  border: 1rpx solid #dde5f0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 148rpx;
  background: #ffffff;
  border: 1rpx solid #dde5f0;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.divider {
  height: 1rpx;
  background: #edf1f6;
  margin: 22rpx 0;
}

.muted {
  color: #6b7280;
}

.strong {
  font-weight: 700;
}

