MQTT_BROKER_MODE=development
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=dongxin-local-gateway
# json is limited to a small pilot; postgres uses the same credentials table as HTTP.
MQTT_DEVICE_AUTH_BACKEND=json
MQTT_DEVICE_CREDENTIALS=
# Same-ECS PostgreSQL: local mode requires 127.0.0.1; never expose port 5432.
# Remote PostgreSQL/RDS: verify-ca mode requires a CA file.
DATABASE_URL=
DATABASE_TLS_MODE=verify-ca
DATABASE_CA_FILE=

# Production requires a DNS name, MQTT_PORT=8883, TLS certificate/key and
# independent 20+ character secrets for every device or PostgreSQL-backed digests.
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=
