MQTT_HOST=0.0.0.0
MQTT_PORT=1883

# The bundled broker is for local development. Production devices should use
# Alibaba Cloud IoT device identities unless a separate broker is approved.
MQTT_BROKER_MODE=development
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=dongxin-local-gateway
MQTT_DEVICE_CREDENTIALS=
