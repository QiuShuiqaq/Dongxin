# Public cutover template. Do not install with the placeholder below.
# Both names may share TCP 443, but only the operations virtual host is IP restricted.
limit_req_zone $binary_remote_addr zone=dongxin_login:1m rate=5r/m;

server {
    listen 443 ssl http2 default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl http2;
    server_name ops.zjdongxin.net;
    ssl_certificate /etc/letsencrypt/live/ops.zjdongxin.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ops.zjdongxin.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow __DONGXIN_OFFICE_CIDR__;
    deny all;

    root /opt/dongxin/current/apps/operations-console/dist;
    index index.html;
    client_max_body_size 10m;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;

    location = /api/auth/login {
        limit_req zone=dongxin_login burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/dongxin-proxy.conf;
    }
    # Only the authenticated staff API surface is reachable on this host.
    # Legacy lab, voice and device-control routes remain internal-only.
    location = /api/health { include /etc/nginx/dongxin-proxy.conf; }
    location = /api/auth/session { include /etc/nginx/dongxin-proxy.conf; }
    location ^~ /api/operations/ { include /etc/nginx/dongxin-proxy.conf; }
    location ^~ /api/knowledge/ { include /etc/nginx/dongxin-proxy.conf; }
    location ^~ /api/providers/ { include /etc/nginx/dongxin-proxy.conf; }
    location = /api/providers { include /etc/nginx/dongxin-proxy.conf; }
    location ^~ /api/test-sets/ { include /etc/nginx/dongxin-proxy.conf; }
    location = /api/test-sets { include /etc/nginx/dongxin-proxy.conf; }
    location = /api/proactive/settings { include /etc/nginx/dongxin-proxy.conf; }
    location = /api/proactive/logs { include /etc/nginx/dongxin-proxy.conf; }
    location /api/ {
        return 404;
    }
    location = /lab { return 308 /lab/; }
    location = /lab/ { rewrite ^ /lab.html last; }
    location /assets/ {
        try_files $uri =404;
        expires 1h;
    }
    location / {
        add_header Cache-Control "no-store";
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name api.zjdongxin.net;
    ssl_certificate /etc/letsencrypt/live/api.zjdongxin.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.zjdongxin.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;

    # Every device request is authenticated by the API with its own identity.
    location ^~ /api/device/v1/ {
        client_max_body_size 1m;
        client_body_timeout 20s;
        include /opt/dongxin/current/deploy/nginx-device-proxy.conf;
    }
    location / { return 404; }
}
