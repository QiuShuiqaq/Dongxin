# Loopback pilot only. Keep this file at /etc/dongxin/mqtt.env, owned by
# dongxin:dongxin with mode 0600. Do not commit populated credentials.
NODE_ENV=production
MQTT_BROKER_MODE=production
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_DEVICE_AUTH_BACKEND=json
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=
MQTT_DEVICE_CREDENTIALS=
MQTT_TLS_CERT_FILE=/etc/dongxin/mqtt/fullchain.pem
MQTT_TLS_KEY_FILE=/etc/dongxin/mqtt/privkey.pem
