# Bounded single-instance pilot; replace secrets on the server, never in Git.
NODE_ENV=production
HOST=127.0.0.1
PORT=3077
DONGXIN_DATA_DIR=/var/lib/dongxin
DONGXIN_PILOT_JSON_MODE=acknowledge-local-json-limits

OPS_AUTH_MODE=enabled
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_DISPLAY_NAME=平台管理员
OPS_ADMIN_PASSWORD_HASH=
OPS_AUTH_TOKEN_SECRET=
# Same origin as the deployed website. For loopback readiness checks use this value.
OPS_CORS_ORIGINS=http://127.0.0.1:8080

# No public device access during the first console-only deployment.
DEVICE_AUTH_MODE=required
DEVICE_AUTH_BACKEND=json
DEVICE_HTTP_CREDENTIALS=
VOICE_HISTORY_BACKEND=json
MQTT_ENABLED=false
# Loopback MQTTS pilot after broker and device credentials are provisioned:
# MQTT_ENABLED=true
# MQTT_URL=mqtts://127.0.0.1:8883
# MQTT_CA_FILE=/etc/dongxin/mqtt/ca.pem
# MQTT_TLS_SERVERNAME=api.zjdongxin.net
# MQTT_GATEWAY_USERNAME=gateway
# MQTT_GATEWAY_PASSWORD=<same private value as mqtt.env>

VOICE_CONCURRENCY=16
VOICE_QUEUE_LENGTH=4
VOICE_QUEUE_WAIT_MS=500
VOICE_TASK_TIMEOUT_MS=10000
ASR_CONCURRENCY=16
LLM_CONCURRENCY=16
TTS_CONCURRENCY=16
AI_STAGE_QUEUE_LENGTH=4
AI_STAGE_QUEUE_WAIT_MS=500
AI_STAGE_TIMEOUT_MS=10000
TEXT_RETENTION_DAYS=90

# Add provider keys through the UI after HTTPS is configured, or edit here privately.
# PostgreSQL will be connected in a separate migration step, not by installing it alone.
